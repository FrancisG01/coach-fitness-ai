{
	# Nada escucha fuera de la red Tailscale, tampoco el puerto 80.
	default_bind {$COACH_BIND_IP}
	admin off
}

{$COACH_HOST} {
	# El certificado lo emite Tailscale (dominio *.ts.net) y Caddy lo renueva solo.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	root * /srv/web
	try_files {path} /index.html
	file_server
}
