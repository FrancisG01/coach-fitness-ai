# Copia este archivo como .env y completa los valores. .env nunca se sube a git.

# Base de datos (solo desarrollo local; en producción usa una contraseña fuerte)
POSTGRES_DB=coach
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach_dev
DATABASE_URL=postgresql+psycopg://coach:coach_dev@localhost:5432/coach

# Redis
REDIS_URL=redis://localhost:6379/0

# Coach IA (Fase 5). La clave se crea en Claude Console.
ANTHROPIC_API_KEY=
